# RS_agent local/trial deployment example.
# Copy to .env for local testing only. Do not put real secrets in this template.

# Default config keeps the service in local Qdrant trial mode.
RS_SERVING_CONFIG=/app/configs/serving/online_service.local_qdrant.yaml
RS_QDRANT_URL=http://qdrant:6333

# Keep endpoints local and authenticated when binding beyond loopback.
RS_SERVING_STRICT_AUTH=0
RS_TRIAL_TOKEN=replace-with-local-trial-token
RS_DEBUG_TOKEN=replace-with-local-debug-token
RS_SIMULATION_TOKEN=replace-with-local-simulation-token
RS_ENABLE_SIMULATION_ENDPOINTS=0
RS_ENABLE_RECALL_ENDPOINT=1
RS_ENABLE_DEMO_ENDPOINT=0

# Agent LLM policy is disabled by default; local Qwen/vLLM is not started by compose.
# To test an external vLLM/OpenAI-compatible endpoint, set RS_AGENT_INFERENCE_POLICY=openai_compatible
# and point the base/model envs at that already-running service. Do not commit real API keys.
RS_AGENT_INFERENCE_POLICY=off
RS_AGENT_OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8001/v1
RS_AGENT_OPENAI_COMPATIBLE_MODEL=replace-with-external-vllm-model-name
RS_AGENT_OPENAI_COMPATIBLE_API_KEY=replace-with-local-openai-compatible-token
RS_AGENT_QWEN_LOCAL_FILES_ONLY=1

# Local PostgreSQL smoke database. Replace the password in deploy/local/.env only; do not commit real secrets.
RS_POSTGRES_DB=rs_agent
RS_POSTGRES_USER=rs_agent
RS_POSTGRES_PASSWORD=replace-with-local-postgres-password
RS_POSTGRES_DSN=postgresql://rs_agent:replace-with-local-postgres-password@postgres:5432/rs_agent
RS_POSTGRES_LOCAL_DSN=postgresql://rs_agent:replace-with-local-postgres-password@127.0.0.1:5432/rs_agent

# Optional read-only dataset wrapper for local/trial serving readiness and smoke reads.
# It uses docker compose exec -T postgres psql; no psycopg/ORM dependency is required.
RS_POSTGRES_DATASET_ENABLED=0
RS_POSTGRES_COMPOSE_FILE=deploy/local/docker-compose.yml
RS_POSTGRES_SERVICE=postgres
RS_POSTGRES_QUERY_TIMEOUT_SECONDS=10

# Optional Cassandra-compatible non-vector candidate store. Local compose uses ScyllaDB with
# a disk-backed ../../data/scylla volume; keep it disabled unless testing the candidate store path.
RS_CANDIDATE_STORE_BACKEND=noop
RS_CASSANDRA_HOSTS=127.0.0.1
RS_CASSANDRA_PORT=9042
RS_CASSANDRA_KEYSPACE=rs_agent
RS_CASSANDRA_DATACENTER=datacenter1
RS_CASSANDRA_USERNAME=
RS_CASSANDRA_PASSWORD=
RS_CASSANDRA_CONNECT_TIMEOUT_SECONDS=5
RS_CASSANDRA_REQUEST_TIMEOUT_SECONDS=3
RS_CASSANDRA_STORE_VERSION=pool500_vnext_hot010_stable_20260522
RS_CASSANDRA_CONSISTENCY=LOCAL_ONE

# Local MinIO artifact store for trial-only artifact resolver/upload smoke.
# Keep this template free of real secrets; replace values only in deploy/local/.env.
RS_ARTIFACT_STORE_BACKEND=minio
RS_MINIO_ENDPOINT=127.0.0.1:9000
RS_MINIO_BUCKET=rs-artifacts-local
RS_MINIO_ACCESS_KEY=replace-with-local-minio-access-key
RS_MINIO_SECRET_KEY=replace-with-local-minio-secret-key
RS_MINIO_SECURE=0

# Resource boundary for local smoke only; heavy builds/evals should move to remote or be user-approved.
RS_LOCAL_MEMORY_CAP_GB=12
