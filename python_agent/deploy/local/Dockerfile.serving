FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    RS_SERVING_CONFIG=/app/configs/serving/online_service.local_milvus.yaml

COPY rs_core ./rs_core
COPY scripts ./scripts
COPY configs ./configs
COPY dic ./dic
COPY pyproject.toml ./
RUN pip install --no-cache-dir ".[serving,milvus-rag]"

EXPOSE 8000
CMD ["python", "scripts/serving/run_service.py", "--host", "127.0.0.1", "--port", "8000"]
