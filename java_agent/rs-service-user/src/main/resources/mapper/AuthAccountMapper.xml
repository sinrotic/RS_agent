<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sinrotic.rs.user.mapper.AuthAccountMapper">

    <resultMap id="AuthAccountLoginRecordMap" type="com.sinrotic.rs.user.domain.entity.AuthAccountLoginRecord">
        <constructor>
            <arg column="account_id" javaType="String"/>
            <arg column="username" javaType="String"/>
            <arg column="password_hash" javaType="String"/>
            <arg column="nickname" javaType="String"/>
            <arg column="status" javaType="String"/>
            <arg column="token_version" javaType="long"/>
        </constructor>
    </resultMap>

    <select id="countByUsername" resultType="int">
        SELECT COUNT(1)
        FROM rs_auth_account
        WHERE username = #{username}
    </select>

    <select id="findLoginAccountByUsername" resultMap="AuthAccountLoginRecordMap">
        SELECT
            account_id,
            username,
            password_hash,
            nickname,
            status,
            token_version
        FROM rs_auth_account
        WHERE username = #{username}
        LIMIT 1
    </select>

    <insert id="insertAccount">
        INSERT INTO rs_auth_account (
            account_id,
            username,
            password_hash,
            nickname,
            avatar_url,
            status,
            token_version
        )
        VALUES (
            #{accountId},
            #{username},
            #{passwordHash},
            #{nickname},
            #{avatarUrl},
            'active',
            0
        )
    </insert>

</mapper>
