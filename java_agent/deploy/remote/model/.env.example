VLLM_VENV=/mnt/data/luo/venvs/rsagent-vllm
MODEL_PATH=/mnt/data/luo/models/Qwen3.5-4B
SERVED_MODEL_NAME=qwen35-4b
VLLM_HOST=127.0.0.1
VLLM_PORT=18082
CUDA_VISIBLE_DEVICES=2
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_QUANTIZATION=auto
VLLM_LANGUAGE_MODEL_ONLY=false
# 批次参数留空时沿用安装版本的默认值；先做真实负载对照再设置。
VLLM_MAX_NUM_BATCHED_TOKENS=
VLLM_MAX_NUM_SEQS=
# MTP 等推测解码必须通过工具、完整回答和重启验收后启用。
VLLM_SPECULATIVE_CONFIG=
# Diagnostic profile only: failed the current Agent tool-path acceptance.
# Requires vLLM 0.24.0; see the quantization report before enabling FP8.
# VLLM_QUANTIZATION=fp8_per_channel
# Keep attention, vision and output projection at original precision.
# VLLM_QUANTIZATION_CONFIG='{"ignore":["lm_head","re:.*visual.*","re:.*linear_attn.*","re:.*self_attn.*"]}'
VLLM_USE_FLASHINFER_SAMPLER=0
VLLM_ENABLE_AUTO_TOOL_CHOICE=true
VLLM_TOOL_CALL_PARSER=qwen3_xml
VLLM_ENFORCE_STRICT_TOOL_CALLING=true
VLLM_STRUCTURED_OUTPUTS_BACKEND=xgrammar
# 只约束普通 JSON 输出的排版；不保证严格工具参数也减少 token。
VLLM_JSON_COMPACT_OUTPUT=false
VLLM_STRUCTURED_OUTPUT_PROBE=true
VLLM_PROBE_TIMEOUT_SEC=30

VLLM_PREFIX_KEEPALIVE=true
VLLM_KEEPALIVE_INTERVAL_SEC=300
VLLM_WARMUP_PROFILES="rs_agent rag_agent"
VLLM_WARMUP_MAX_TOKENS=1
VLLM_WARMUP_CONCURRENCY=8
# 启动时补齐部分命中的输入对齐类别及解码批次；全部成功后才 ready。
# 运行中可空闲补热，不要求重启模型；定时保温不重复合成批次。
VLLM_KERNEL_WARMUP=false
VLLM_KERNEL_WARMUP_BATCH_SIZES="1 4 8 16"
# 额外预热 0 至 16 路；0 关闭。启用后再次校验并补回真实前缀，全部成功才 ready。
VLLM_EXTRA_WARMUP_CONCURRENCY=0
VLLM_WARMUP_ONLY_WHEN_IDLE=true
# 实验候选未通过本轮正式规划门槛，默认关闭，保留原整轮空闲检查。
VLLM_RECHECK_IDLE_PER_PREFIX=false
# JSON 数组：[{"profile":"shopping","payload":{真实 messages/tools/template 参数}}]
# 配置后严格读取该文件，不再用兜底提示替代真实前缀。
VLLM_WARMUP_PAYLOAD_FILE=
VLLM_DELAY_AFTER_WARMUP_SEC=2
VLLM_READY_TIMEOUT_SEC=600
VLLM_READY_INTERVAL_SEC=2
VLLM_READY_FILE=/tmp/rs_agent_latency/vllm_qwen35_4b.ready

# Optional. Prefer a local file or the Agent runtime endpoint when you need
# warmup to track a custom platform prompt.
AGENT_SYSTEM_PROMPT_FILE=
AGENT_SYSTEM_PROMPT_URL=http://127.0.0.1:18104/api/platform/agent/runtime/system-prompt
