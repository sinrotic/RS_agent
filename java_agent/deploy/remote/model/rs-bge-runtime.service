[Unit]
Description=RS Agent BGE embedding and reranking runtime
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/RS_agent_java/model_deploy
ExecStart=/bin/bash %h/RS_agent_java/model_deploy/run_bge_m3_embedding.sh
Restart=always
RestartSec=10
TimeoutStartSec=360
TimeoutStopSec=30
KillMode=control-group
MemoryMax=8G

[Install]
WantedBy=default.target
