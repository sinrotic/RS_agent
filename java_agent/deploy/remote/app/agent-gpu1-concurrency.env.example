# 2026-10-11 GPU 1 当前量化模型的 Agent 编排候选参数。
# 将这些键合并到既有 .env；本文件不包含模型地址、密钥或模型服务参数。
# 适用范围与压力测试证据见 docs/reports/agent-concurrency-optimization-20261011。
RS_AGENT_MAX_ACTIVE_LOOPS=32
RS_AGENT_ACTIVE_LOOP_ACQUIRE_TIMEOUT_MS=300
RS_AGENT_MAX_MODEL_STREAMS=16
RS_AGENT_MODEL_STREAM_ACQUIRE_TIMEOUT_MS=15000
RS_AGENT_MAX_RECOMMENDATION_CALLS=4
RS_AGENT_RECOMMENDATION_ACQUIRE_TIMEOUT_MS=15000
RS_AGENT_MAX_TOOL_CALLS=64
RS_AGENT_TOOL_ACQUIRE_TIMEOUT_MS=300
RS_AGENT_MAX_SESSION_QUEUE_SIZE=2
RS_AGENT_SESSION_QUEUE_TIMEOUT_MS=500
