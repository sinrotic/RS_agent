COMPOSE_PROJECT_NAME=rs-agent-java-app

RS_JAVA_OPTS=-Xms128m -Xmx512m
RS_DEPLOYMENT_PROFILE=recommend
RS_SCHEMA_DIR=../../../sql

RS_GATEWAY_HOST_PORT=18088
RS_GATEWAY_TRUSTED_PROXIES=rs-frontend
RS_RECOMMEND_PROFILE_HALF_LIFE_DAYS=30
RS_USER_HOST_PORT=18101
RS_CATALOG_HOST_PORT=18102
RS_CATALOG_CACHE_ENABLED=true
RS_CATALOG_CACHE_ITEM_TTL_SECONDS=86400
RS_CATALOG_CACHE_ITEM_TTL_JITTER_SECONDS=3600
RS_CATALOG_LOCAL_CACHE_ENABLED=true
RS_CATALOG_LOCAL_CACHE_MAX_ITEMS=10000
RS_CATALOG_LOCAL_CACHE_ITEM_TTL_SECONDS=300
RS_CATALOG_LOCAL_CACHE_NEGATIVE_TTL_SECONDS=30
RS_RECOMMEND_HOST_PORT=18103
RS_AGENT_HOST_PORT=18104
RS_MODEL_HOST_PORT=18105
RS_PLATFORM_TRACE_HOST_PORT=18108
RS_PLATFORM_TRACE_CLIENTS_ENABLED=true
RS_ORDER_HOST_PORT=18091
RS_INVENTORY_HOST_PORT=18092
RS_PAYMENT_HOST_PORT=18093
RS_SECKILL_HOST_PORT=18094

RS_MYSQL_DATABASE=rs_agent
RS_MYSQL_USER=rs_agent
RS_MYSQL_PASSWORD=rs_agent_dev_password
RS_REDIS_PASSWORD=rs_agent_redis_password
RS_AGENT_SESSION_PERSISTENCE_ENABLED=true
RS_AGENT_SESSION_SCHEMA_VERSION=agent_session_v1
RS_AUTH_REFRESH_COOKIE_SECURE=true

# 仅联调环境启用，商品详情页会明确展示“模拟支付（不扣款）”。
RS_CHECKOUT_MOCK_PAYMENT_ENABLED=false
# Payment模拟回调另需配置至少32字节的独立密钥；留空时拒绝回调。
RS_PAYMENT_MOCK_CALLBACK_SECRET=
RS_SECKILL_MAX_REDRIVES=10
RS_CHECKOUT_MAX_ATTEMPTS=20
RS_CHECKOUT_WORKER_BATCH_SIZE=100
RS_CHECKOUT_WORKER_CONCURRENCY=4
RS_SECKILL_WORKER_BATCH_SIZE=100
RS_SECKILL_WORKER_PUBLISH_CONCURRENCY=4
RS_SECKILL_WORKER_RECONCILE_CONCURRENCY=4
RS_SECKILL_WORKER_PUBLISH_DELAY_MS=100
RS_SECKILL_WORKER_RECONCILE_DELAY_MS=1000
RS_PAYMENT_NOTIFICATION_MAX_ATTEMPTS=20
# 仅用于 mock 支付记录的退款流程演示，默认关闭，不执行真实退款。
RS_PAYMENT_MOCK_REFUND_ENABLED=false
RS_PROMOTION_HOST_PORT=18095

RS_CATALOG_BASE_URL=http://rs-service-catalog:18102
RS_MODEL_BASE_URL=http://rs-service-model:18105
RS_MODEL_RUNTIME_EMBEDDING_BASE_URL=http://172.21.0.1:18115
# Separate runtime implementing /internal/model/rank and /health; empty means unavailable.
RS_MODEL_RUNTIME_RERANK_BASE_URL=
RS_ELASTICSEARCH_BASE_URL=http://elasticsearch:9200
RS_MILVUS_BASE_URL=http://milvus-standalone:19530
RS_MILVUS_TOKEN=
RS_RECOMMEND_EMBEDDING_MODEL_KEY=bge-m3
# 先准备 epoch5 推理服务和独立 64 维索引，再启用双塔召回。
RS_RECOMMEND_TWO_TOWER_ENABLED=false
RS_RECOMMEND_MULTI_RECALL_ENABLED=false
RS_RECOMMEND_TRAINED_RANKING_ENABLED=false
RS_RECOMMEND_TRAINED_RANKING_BASE_URL=http://172.21.0.1:18119
RS_RECOMMEND_TRAINED_RANKING_VERSION=cold_deepfm_20260914
RS_RECOMMEND_MULTI_RECALL_BASE_URL=http://172.21.0.1:18118
RS_RECOMMEND_MULTI_RECALL_VERSION=multi_recall_20260913
RS_RECOMMEND_TWO_TOWER_BASE_URL=http://172.21.0.1:18117
RS_RECOMMEND_TWO_TOWER_MODEL_KEY=two_tower_sparse_aware_epoch5_queryv2
RS_RECOMMEND_TWO_TOWER_COLLECTION=rs_agent_two_tower_epoch5_20260913
# 商品三塔需成组覆盖 base-url/model-key/collection/dimension；部署版本见三塔实验报告。
RS_RECOMMEND_TWO_TOWER_DIMENSION=64
RS_RECOMMEND_TWO_TOWER_PRIMARY_SHARE=0
RS_RECOMMEND_QUERY_TOWER_ENABLED=false
RS_RECOMMEND_SEMANTIC_INDEX_COLLECTION=rs_agent_semantic_items_bge_m3_v1
RS_RECOMMEND_RAG_ELASTICSEARCH_INDEX=rs_agent_rag_bm25_v1
RS_RECOMMEND_RAG_MILVUS_COLLECTION=rs_agent_rag_chunks_milvus_v1
RS_RECOMMEND_RAG_EMBEDDING_MODEL_KEY=bge-m3
RS_RECOMMEND_RAG_RERANK_MODEL_KEY=bge-reranker-v2-m3
RS_RECOMMEND_RAG_RRF_K=60
RS_RECOMMEND_FEEDBACK_PERSISTENCE=jdbc
RS_RECOMMEND_FEEDBACK_PROJECTION=redis

# 连接本地 Qwen/vLLM 时启用；外部供应商保持 false。
RS_AGENT_CONSTRAINED_DECODING_ENABLED=false

# 单轮推荐优化：完整业务延迟和质量门禁通过后，再启用快速路径。
RS_AGENT_DIRECT_RECOMMENDATION_ENABLED=false
# 默认 0 继承模型预算；16K 本地 Qwen 验收使用 4096，只扩大受约束的最终回答。
RS_AGENT_FINAL_ANSWER_MAX_TOKENS=0
# 仅已验收的 vLLM 使用：省略最终区块不适用的 nullable 字段；保留商品卡片与 A2UI。
RS_AGENT_COMPACT_TOOL_SCHEMAS_ENABLED=false
# 完整 SSE 的有界期限；这不是模型调用加速，不用于统计性能收益。
RS_AGENT_STREAM_REQUEST_TIMEOUT=120s
# Agent 请求调度：不同 Session 并行，同一 Session 顺序执行。
# 通用默认值；GPU 1 已验收的候选参数见 agent-gpu1-concurrency.env.example。
RS_AGENT_MAX_ACTIVE_LOOPS=32
RS_AGENT_ACTIVE_LOOP_ACQUIRE_TIMEOUT_MS=300
RS_AGENT_MAX_MODEL_STREAMS=8
RS_AGENT_MODEL_STREAM_ACQUIRE_TIMEOUT_MS=200
RS_AGENT_MAX_RECOMMENDATION_CALLS=8
RS_AGENT_RECOMMENDATION_ACQUIRE_TIMEOUT_MS=15000
RS_AGENT_MAX_TOOL_CALLS=64
RS_AGENT_TOOL_ACQUIRE_TIMEOUT_MS=300
# 工具执行治理：等待许可也计入调用期限；超时不自动重试，暂时故障只重试已授权可重放工具。
RS_AGENT_TOOL_GOVERNANCE_ENABLED=true
RS_AGENT_TOOL_MAX_ATTEMPTS=2
RS_AGENT_TOOL_MAX_ATTEMPTS_PER_TURN=32
RS_AGENT_TOOL_EXECUTION_TIMEOUT_MS=30000
RS_AGENT_TURN_TIMEOUT_MS=120000
RS_AGENT_TOOL_RETRY_DELAY_MS=50
RS_AGENT_TOOL_NO_PROGRESS_LIMIT=3
RS_AGENT_TOOL_CIRCUIT_FAILURE_THRESHOLD=3
RS_AGENT_TOOL_CIRCUIT_OPEN_MS=10000
RS_AGENT_MAX_SESSION_QUEUE_SIZE=2
RS_AGENT_SESSION_QUEUE_TIMEOUT_MS=500
# 已验收的首轮品类/预算请求：复用真实推荐流程，必须调用 LLM 生成正文。
# 与 DIRECT 同时启用时优先经过 LLM；高级条件、历史、定制配置或事实不足仍走通用流程。
RS_AGENT_LLM_SYNTHESIS_ENABLED=false
RS_AGENT_CATALOG_CURRENCY=
RS_AGENT_PERFORMANCE_OBSERVATION_ENABLED=false
RS_RECOMMEND_PERFORMANCE_OBSERVATION_ENABLED=false
# 必须对应实际模型权重、精度及预处理版本；留空时不缓存计算结果。
RS_RECOMMEND_INFERENCE_CACHE_EMBEDDING_VERSION=
RS_RECOMMEND_INFERENCE_CACHE_RERANKER_VERSION=
RS_RECOMMEND_INFERENCE_CACHE_MAX_BYTES=33554432
RS_RECOMMEND_INFERENCE_CACHE_TTL_SECONDS=300
# Trace 异步导出有界队列、单条负载上限和网络/退出超时；排满时丢弃观测，不阻塞推荐。
RS_AGENT_TRACE_QUEUE_CAPACITY=512
RS_AGENT_TRACE_REQUEST_TIMEOUT_MS=2000
RS_AGENT_TRACE_SHUTDOWN_TIMEOUT_MS=3000
RS_AGENT_TRACE_MAX_EVENT_BYTES=65536

# 可选 OTLP/HTTP JSON 导出，与现有平台开关独立；默认关闭。
# endpoint 填完整 traces URL；Langfuse 形如 https://<host>/api/public/otel/v1/traces。
# Authorization 由密钥管理注入（Langfuse: Basic base64(publicKey:secretKey)），禁止提交真实值。
# identity-key 至少 16 字符，用于 HMAC 化会话/调用标识；跨实例保持一致，轮换后关联会变化。
RS_AGENT_TRACE_OTLP_ENABLED=false
RS_AGENT_TRACE_OTLP_ENDPOINT=
RS_AGENT_TRACE_OTLP_AUTHORIZATION=
RS_AGENT_TRACE_OTLP_IDENTITY_KEY=
RS_AGENT_TRACE_OTLP_LANGFUSE=false
RS_AGENT_TRACE_OTLP_SERVICE_NAME=rs-service-agent
# 可选运维确认的模型别名；留空时不从事件正文推断模型版本。
RS_AGENT_TRACE_OTLP_MODEL_NAME=
# Agent/Recommend 的显式 MySQL 连接池；每个服务实例分别占用连接预算。
RS_AGENT_MYSQL_MAXIMUM_POOL_SIZE=8
RS_AGENT_MYSQL_MINIMUM_IDLE=2
RS_AGENT_MYSQL_CONNECTION_TIMEOUT_MS=3000
RS_RECOMMEND_FEEDBACK_JDBC_MAXIMUM_POOL_SIZE=8
RS_RECOMMEND_FEEDBACK_JDBC_MINIMUM_IDLE=2
RS_RECOMMEND_FEEDBACK_JDBC_CONNECTION_TIMEOUT_MS=3000

# 运维接口默认拒绝未认证访问；两枚不同的随机凭证，至少 32 字符，留空不会开放接口。
RS_COMMERCE_OPS_READ_TOKEN=
RS_COMMERCE_OPS_WRITE_TOKEN=
RS_COMMERCE_OPS_OPERATOR_ID=commerce-operator
