COMPOSE_PROJECT_NAME=rs-agent-java

RS_MYSQL_HOST_PORT=13306
RS_MYSQL_DATABASE=rs_agent
RS_MYSQL_USER=rs_agent
RS_MYSQL_PASSWORD=rs_agent_dev_password
RS_MYSQL_ROOT_PASSWORD=rs_agent_root_password
# 未设置时仍使用 ../db/mysql；迁移前先执行 migrate_mysql_to_nvme.py 预检并冷备。
# RS_MYSQL_DATA_DIR=/var/lib/rs-agent-java/mysql-nvme-20261010
# 空间受限时保留已有业务库在原盘，使用 docker-compose.mysql-hybrid.yml。
# RS_MYSQL_LEGACY_DATABASE_DIR=/home/luo/RS_agent_java/db/mysql/rs_agent
# COMPOSE_FILE=docker-compose.yml:docker-compose.mysql-hybrid.yml

RS_REDIS_HOST_PORT=16379
RS_REDIS_PASSWORD=rs_agent_redis_password

RS_NACOS_HOST_PORT=18848
RS_NACOS_CONSOLE_PORT=18080
RS_NACOS_GRPC_PORT=19848
RS_NACOS_RAFT_PORT=19849
RS_NACOS_AUTH_TOKEN=UlNfQUdFTlRfSkFWQV9ERVZfTkFDT1NfQVVUSF9UT0tFTl8yMDI2
RS_NACOS_AUTH_IDENTITY_KEY=rs-agent-java
RS_NACOS_AUTH_IDENTITY_VALUE=rs-agent-java-dev

RS_ELASTICSEARCH_HOST_PORT=19200

RS_MINIO_API_PORT=19000
RS_MINIO_CONSOLE_PORT=19001
RS_MINIO_ROOT_USER=rs_agent
RS_MINIO_ROOT_PASSWORD=rs_agent_minio_password

RS_SCYLLA_HOST_PORT=19042
RS_CASSANDRA_CLUSTER_NAME=rs-agent-java
RS_CASSANDRA_DC=datacenter1
RS_CASSANDRA_MAX_HEAP_SIZE=1G
RS_CASSANDRA_HEAP_NEWSIZE=256M

RS_MILVUS_HOST_PORT=19530
RS_MILVUS_METRICS_PORT=19091
RS_MILVUS_MINIO_ACCESS_KEY=minioadmin
RS_MILVUS_MINIO_SECRET_KEY=minioadmin

# 单 broker 联调默认 1 副本；业务和 DLT 必须使用相同分区数。
RS_COMMERCE_KAFKA_PARTITIONS=3
RS_COMMERCE_KAFKA_REPLICAS=1
